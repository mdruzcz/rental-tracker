# Copy this file to .env and fill in your values. .env is gitignored.

# Twilio SMS credentials. https://console.twilio.com -> Account info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=+15555555555

# Supabase project that holds the rental_* tables.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon/publishable key — safe to expose to the browser (login screen).
SUPABASE_ANON_KEY=eyJhbGci...your_anon_key
# Service-role SECRET key — server-side only, never exposed to the browser.
# Dashboard -> Project Settings -> API -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your_service_role_key

# Comma-separated emails allowed to log in.
RENTAL_ALLOWED_EMAILS=you@example.com,friend@example.com

# PriceLabs dynamic pricing API key (Account Settings -> API Details)
PRICELABS_API_KEY=your_pricelabs_key

# Secret guarding the Vercel Cron scheduler endpoint (set the same value in Vercel env vars)
CRON_SECRET=generate_a_random_string
